            "title": "Cuisine",
            "type": "string"
          },
          "Diet": {
            "enum": [
              "vegan",
              "vegetarian",
              "non_vegetarian"
            ],
            "title": "Diet",
            "type": "string"
          }
        },
        "properties": {
          "cuisines": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/$defs/Cuisine"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only these cuisines.",
            "title": "Cuisines"
          },
          "diet": {
