# Local-only material: course baseline, backups, working notes, audit reports, the project report. Never committed.
private/
docs/audits/
docs/report.md
*.bundle

# Documents and notebooks are not versioned here
*.pdf
*.ipynb

# Secrets, credentials and local config
.env
.env.*
!.env.example
.streamlit/secrets.toml
.aws/
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json

# User data: uploads are never persisted; logs and traces may contain user text
uploads/
tmp/
logs/
*.log

# Local service state (Langfuse, Qdrant, Prefect)
langfuse-data/
qdrant_storage/
.prefect/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Generated artifacts (rebuilt by the ingestion flow)
data/processed/catalog.db*
data/processed/indexes/
data/processed/thumbs/
eval/results/*.tmp

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
