# Secrets for the local Langfuse stack (docker-compose.yml). Copy to .env.langfuse and fill in every value.
# Never commit .env.langfuse. Generate each secret with: openssl rand -hex 32
# Docker Compose reads this file only through --env-file; the app's own .env stays separate.

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
NEXTAUTH_SECRET=
# Exactly 64 hex characters (openssl rand -hex 32).
ENCRYPTION_KEY=

# The project's API keys, created on first start. Copy the same two values into .env as
# LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY. Any string with these prefixes works locally.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-

# Login for http://localhost:3000
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_PASSWORD=
