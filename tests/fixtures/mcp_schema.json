{
  "instructions": "Tools for finding dishes at the restaurants in this catalog under a diner's hard constraints (diet, allergens, calories, price, cuisine). Search never returns a dish that breaks the constraints given. Pass constraints as arguments; ones the query states in words ('peanut-free', 'vegan') are applied too, and the result's note names them. A dish marked unverified has an ingredient whose recipe can't be checked: ask the diner before recommending it to someone avoiding an allergen, then search again with include_unverified. may_contain allergens come from the photo only and are warnings. Prices are in Indian rupees. Allergen information is derived from restaurant labels, ingredient lists and photos of the dish. It can be incomplete and is not medical advice: anyone with a serious allergy should confirm with the restaurant.",
  "prompts": [
    {
      "arguments": [
        {
          "name": "constraints",
          "required": true
        }
      ],
      "description": "Plan a meal under a diner's constraints, checked with the tools.",
      "name": "plan_meal"
    },
    {
      "arguments": [
        {
          "name": "description",
          "required": true
        }
      ],
      "description": "Find catalog dishes like one the diner describes or photographed.",
      "name": "find_similar_dish"
    }
  ],
  "resource_templates": [
    {
      "description": "One dish in full.",
      "mime_type": "application/json",
      "name": "dish",
      "uri_template": "menu://dishes/{dish_id}"
    },
    {
      "description": "A dish's photo (WebP).",
      "mime_type": "image/webp",
      "name": "dish_image",
      "uri_template": "menu://dishes/{dish_id}/image"
    }
  ],
  "resources": [
    {
      "description": "Every dish, in short form.",
      "mime_type": "application/json",
      "name": "catalog",
      "uri": "menu://catalog"
    },
    {
      "description": "The allergens, their words, the rules.",
      "mime_type": "application/json",
      "name": "allergen_policy",
      "uri": "menu://policy/allergens"
    }
  ],
  "tools": [
