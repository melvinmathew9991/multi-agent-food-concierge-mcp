# Matches .gitattributes (LF) and ruff (120 columns). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.{csv,jsonl,lock}]
# Data and generated files keep their bytes as written.
trim_trailing_whitespace = false
insert_final_newline = unset
