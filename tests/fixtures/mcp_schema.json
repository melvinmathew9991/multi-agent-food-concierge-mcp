      "description": "Find dishes for a request, ranked by relevance. Never returns a dish that breaks the constraints.\n\nConstraints the query states in words (\"peanut-free\", \"no dairy\", \"vegan\") are added to the arguments, and\nthe note says which; pass them as arguments too.",
      "input_schema": {
        "$defs": {
          "Cuisine": {
            "enum": [
              "north_indian",
              "south_indian",
              "punjabi",
              "mughlai",
              "hyderabadi",
              "bengali",
              "gujarati",
              "kerala",
              "maharashtrian",
              "indian_street_food",
              "indo_chinese",
              "continental",
              "italian",
              "american",
              "mediterranean",
              "middle_eastern",
              "mexican",
              "chinese",
              "thai",
              "japanese",
              "korean"
