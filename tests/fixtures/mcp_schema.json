            ],
            "default": null,
            "description": "vegan, vegetarian (lacto-ovo) or non_vegetarian (anything)."
          },
          "eggless": {
            "default": false,
            "description": "Leave out dishes with egg.",
            "title": "Eggless",
            "type": "boolean"
          },
          "exclude_allergens": {
