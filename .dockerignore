# Only what the image needs goes into the build context: the locks, the source and the tracked data.
# Everything else is left out, secrets above all (.env and friends must never reach a layer).
*
!pyproject.toml
!requirements.lock
!requirements-dev.lock
!src/
!data/lexicon/
!data/raw/
!data/photos/
!data/processed/image_descriptions.jsonl

# Never, even inside an allowed folder
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.env
src/*.egg-info
