# Copy to .env and fill in. Never commit .env.
# Default configuration is zero cost: free tiers and local models only.
# Every key here is a setting in src/food_concierge/config.py; blank values keep the default.
# Unknown keys in .env are rejected at startup, so typos fail loudly.

# Providers: groq | gemini | ollama | fake   (paid, off by default: openai | bedrock)
CHAT_PROVIDER=groq
FALLBACK_PROVIDERS=gemini
EMBED_PROVIDER=fastembed
ALLOW_PAID_PROVIDERS=false

# Free hosted models (free tiers; model names verified per phase)
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_CHAT_MODEL=
GROQ_VISION_MODEL=
GEMINI_CHAT_MODEL=
GEMINI_VISION_MODEL=

# Seed for routing, extraction, vision and judging (temperature 0) where the provider accepts one
MODEL_SEED=7

# Local models
OLLAMA_BASE_URL=http://localhost:11434

# LLMOps (Langfuse Cloud Hobby or self-hosted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
TRACING_ENABLED=true
TRACE_SAMPLE_RATE=1.0
ENVIRONMENT=development

# Paid providers: implemented and stub-tested only; require ALLOW_PAID_PROVIDERS=true.
# AWS credentials come from the standard AWS credential chain, never from this file.
OPENAI_API_KEY=
AWS_REGION=

# API access: one bearer token per scope. Leave blank locally; set strong random values in platform secrets.
API_TOKEN_PUBLIC=
API_TOKEN_AGENT=
API_TOKEN_ADMIN=
LOG_LEVEL=INFO
